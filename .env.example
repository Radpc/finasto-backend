# Copy to .env for local development. Never commit real values.

# MySQL connection used by Prisma. Matches docker-compose.yml.
DATABASE_URL=mysql://finasto:finasto@localhost:3306/finasto

# Secret used to sign user JWTs. Use a long random value outside local dev:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_USER_SECRET=change-me-local-only

# HTTP port (default 3000)
PORT=3000

# Comma-separated origins allowed by CORS (default http://localhost:5173)
CORS_ORIGINS=http://localhost:5173

# Token for the manual job endpoints (header x-jobs-token). Leave empty to
# disable them; the jobs still run on their schedule.
JOBS_TOKEN=

# Swagger UI at /api is on outside production; set true to force it on.
ENABLE_SWAGGER=
